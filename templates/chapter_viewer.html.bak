<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ manga[1] }} - Chapter {{ chapter[1] }} | NOVUS Reader</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              background: '#0a0a0a',
              card: '#141414',
              accent: '#dc2626',
              'accent-hover': '#b91c1c',
            },
            fontFamily: {
              sans: ['Outfit', 'Inter', 'sans-serif'],
            }
          }
        }
      }
    </script>
    
    <!-- Valid Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body { 
            background-color: #0a0a0a; 
            color: #fff; 
            font-family: 'Outfit', sans-serif;
            overflow: hidden; /* App like */
        }
        
        /* Custom Scrollbar for inner containers */
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #141414; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #333; border-radius: 3px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #dc2626; }

        .glass-panel {
            background: rgba(20, 20, 20, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .btn-icon {
            @apply p-2 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all duration-200;
        }

        /* Hover Card Effect */
        .hover-card {
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .hover-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px -10px rgba(220, 38, 38, 0.2);
        }
    </style>
</head>
<body class="flex flex-col h-screen">

    <!-- Navbar (App.tsx Replica) -->
    <nav class="h-16 border-b border-zinc-800 bg-black/50 backdrop-blur-md flex items-center justify-between px-6 z-50">
        <!-- Brand -->
        <div class="flex items-center gap-3">
            <a href="{{ url_for('home') }}" class="text-2xl font-bold tracking-tighter text-white flex items-center gap-2">
                <span class="text-red-600 text-3xl">◆</span> NOVUS
            </a>
            
            <div class="h-6 w-px bg-zinc-800 mx-4"></div>

            <!-- Breadcrumbs / Title -->
            <div class="flex flex-col">
                <h1 class="text-sm font-bold text-white leading-none">{{ manga[1] }}</h1>
                <span class="text-xs text-zinc-500 mt-1">Chapter {{ chapter[1] }}</span>
            </div>
        </div>

        <!-- Center Nav Items -->
        <div class="hidden md:flex items-center bg-zinc-900/50 rounded-full p-1 border border-zinc-800/50">
            <a href="{{ url_for('manga') }}" class="px-4 py-1.5 text-sm font-medium text-zinc-400 hover:text-white transition-colors">Library</a>
            <a href="{{ url_for('read_manga', id=manga[0]) }}" class="px-4 py-1.5 text-sm font-medium text-zinc-400 hover:text-white transition-colors">Details</a>
            <div class="bg-zinc-800 px-4 py-1.5 rounded-full text-sm font-semibold text-white shadow-lg shadow-red-900/20">Reader</div>
        </div>

        <!-- Right Actions -->
        <div class="flex items-center gap-3">
            <button class="btn-icon" id="zenModeBtn" title="Zen Mode">
                <i class="fas fa-expand-alt"></i>
            </button>
            <button class="btn-icon" id="settingsBtn" title="Settings">
                <i class="fas fa-cog"></i>
            </button>
            <div class="w-8 h-8 rounded-full bg-zinc-800 border border-zinc-700 overflow-hidden ml-2">
                {% if current_user.avatar_url %}
                <img src="{{ current_user.avatar_url }}" class="w-full h-full object-cover">
                {% else %}
                <div class="w-full h-full flex items-center justify-center text-xs text-zinc-500">U</div>
                {% endif %}
            </div>
        </div>
    </nav>

    <!-- Main Content Grid -->
    <div class="flex-1 flex overflow-hidden">
        
        <!-- Left Sidebar (Collapsible) - Optional, mimicking Ranking layout 'Filters' or similar but using for Chapter List -->
        <!-- For now, we keep it simple: Main Reader + Right Info Panel -->
        
        <!-- Reader Area -->
        <main class="flex-1 relative bg-[#050505] overflow-hidden flex flex-col group" id="mainReaderArea">
             <!-- Reader Header Overlay (Page selector) -->
             <div class="absolute top-4 left-1/2 -translate-x-1/2 bg-zinc-900/90 backdrop-blur border border-zinc-800 rounded-full px-4 py-2 flex items-center gap-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-40">
                <button class="text-zinc-400 hover:text-white" onclick="prevPage()"><i class="fas fa-chevron-left"></i></button>
                <span class="text-sm font-medium"><span id="pageCounter" class="text-white">1</span> <span class="text-zinc-500">/ <span id="totalPagesDisplay">--</span></span></span>
                <button class="text-zinc-400 hover:text-white" onclick="nextPage()"><i class="fas fa-chevron-right"></i></button>
             </div>

             <!-- Content -->
             <div id="mangaViewer" class="flex-1 flex items-center justify-center overflow-auto custom-scrollbar p-6">
                <!-- Pages / PDF embedded here -->
                <div class="text-zinc-500 animate-pulse">Loading Content...</div>
             </div>
        </main>

        <!-- Right Sidebar (RankingCard style) -->
        <aside class="w-80 bg-[#0a0a0a] border-l border-zinc-800 flex flex-col z-40 custom-scrollbar" id="readerSidebar">
            <div class="p-6 space-y-6">
                
                <!-- Current Chapter Card -->
                <div class="bg-zinc-900/50 border border-zinc-800 rounded-xl p-5 hover-card relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-3 opacity-10 group-hover:opacity-20 transition-opacity">
                         <i class="fas fa-bookmark text-6xl text-red-600"></i>
                    </div>
                    <h3 class="text-zinc-400 text-xs font-bold uppercase tracking-wider mb-2">NOW READING</h3>
                    <div class="text-xl font-bold text-white mb-1">Chapter {{ chapter[1] }}</div>
                    <div class="text-sm text-zinc-500 mb-4 truncate">{{ chapter[2] if chapter[2] else 'Untitled Chapter' }}</div>
                    
                    <div class="grid grid-cols-2 gap-2">
                        <button id="prevChapterBtn" class="bg-zinc-800 hover:bg-zinc-700 text-white py-2 rounded-lg text-sm font-medium transition-colors flex items-center justify-center gap-2">
                            <i class="fas fa-arrow-left text-xs"></i> Prev
                        </button>
                        <button id="nextChapterBtn" class="bg-red-600 hover:bg-red-700 text-white py-2 rounded-lg text-sm font-medium transition-colors flex items-center justify-center gap-2 shadow-lg shadow-red-900/20">
                            Next <i class="fas fa-arrow-right text-xs"></i>
                        </button>
                    </div>
                </div>

                <!-- AI Analysis Card -->
                <div class="bg-zinc-900/50 border border-zinc-800 rounded-xl p-5 hover-card">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-zinc-400 text-xs font-bold uppercase tracking-wider flex items-center gap-2">
                            <i class="fas fa-sparkles text-red-500"></i> AI Insight
                        </h3>
                        <span class="bg-red-500/10 text-red-500 text-[10px] font-bold px-2 py-0.5 rounded-full border border-red-500/20">BETA</span>
                    </div>
                    
                    <div class="space-y-3">
                        <div class="h-2 w-3/4 bg-zinc-800 rounded animate-pulse"></div>
                        <div class="h-2 w-full bg-zinc-800 rounded animate-pulse"></div>
                        <div class="h-2 w-5/6 bg-zinc-800 rounded animate-pulse"></div>
                    </div>

                    <button class="w-full mt-4 border border-zinc-700 hover:bg-zinc-800 text-zinc-300 py-2 rounded-lg text-sm font-medium transition-colors">
                        Generate Summary
                    </button>
                </div>

                <!-- Characters -->
                 <div class="bg-zinc-900/50 border border-zinc-800 rounded-xl p-5">
                    <h3 class="text-zinc-400 text-xs font-bold uppercase tracking-wider mb-4">Characters in Scene</h3>
                    <div class="flex flex-wrap gap-2">
                        <!-- Placeholders -->
                        <div class="w-10 h-10 rounded-full bg-zinc-800 border-2 border-zinc-700"></div>
                        <div class="w-10 h-10 rounded-full bg-zinc-800 border-2 border-zinc-700"></div>
                        <div class="w-10 h-10 rounded-full bg-zinc-800 border-2 border-zinc-700 opacity-50"></div>
                    </div>
                    <p class="text-xs text-zinc-600 mt-3 italic">Waiting for AI detection...</p>
                 </div>

            </div>
            
            <div class="mt-auto p-6 border-t border-zinc-800">
                <button class="w-full flex items-center justify-center gap-2 text-zinc-500 hover:text-white transition-colors text-sm">
                    <i class="fas fa-keyboard"></i> Keyboard Shortcuts
                </button>
            </div>
        </aside>

    </div>

    <!-- Hidden Data for JS -->
    <div id="data-store" 
         data-chapter-id="{{ chapter[0] if chapter else 0 }}"
         data-chapter-file="{{ chapter[3] if chapter and chapter[3] else '' }}"
         data-manga-id="{{ manga[0] }}"
         data-chapters='{{ chapters|tojson }}'
         style="display:none;"></div>

    <!-- MAIN SCRIPT -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
    <script>
        // --- Core Reader Logic (Ported) ---
        const dataStore = document.getElementById('data-store');
        const chapterId = dataStore.dataset.chapterId;
        const chapterFile = dataStore.dataset.chapterFile;
        const mangaId = dataStore.dataset.mangaId;
        const chapters = JSON.parse(dataStore.dataset.chapters || '[]');
        
        let pdfDoc = null;
        let pageNum = 1;
        let scale = 1.0;
        
        async function loadContent() {
            const viewer = document.getElementById('mangaViewer');
            viewer.innerHTML = '';
            
            if (chapterFile.endsWith('.pdf')) {
                // PDF Logic
                try {
                    const url = `{{ url_for('static', filename='books/') }}${chapterFile}`;
                    viewer.innerHTML = '<div class="text-white">Loading PDF...</div>';
                    
                    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
                    pdfDoc = await pdfjsLib.getDocument(url).promise;
                    
                    document.getElementById('totalPagesDisplay').textContent = pdfDoc.numPages;
                    renderPage(pageNum);
                    
                } catch(e) {
                    viewer.innerHTML = `<div class="text-red-500">Error loading PDF: ${e.message}</div>`;
                }
            } else {
                 // Image Folder Logic (Assumed based on previous code)
                 viewer.innerHTML = '<div class="text-center text-zinc-500">Image mode not fully implemented in this port test.<br>Using PDF logic by default.</div>';
            }
        }
        
        async function renderPage(num) {
            if(!pdfDoc) return;
            const page = await pdfDoc.getPage(num);
            const viewport = page.getViewport({scale: 1.5}); // Default zoom
            
            const canvas = document.createElement('canvas');
            const context = canvas.getContext('2d');
            canvas.height = viewport.height;
            canvas.width = viewport.width;
            canvas.className = 'shadow-2xl shadow-black mb-4 rounded';
            
            const viewer = document.getElementById('mangaViewer');
            viewer.innerHTML = ''; // Single page mode for now
            viewer.appendChild(canvas);
            
            await page.render({canvasContext: context, viewport: viewport}).promise;
            
            document.getElementById('pageCounter').innerText = num;
        }

        function prevPage() {
            if(pageNum <= 1) return;
            pageNum--;
            renderPage(pageNum);
        }
        
        function nextPage() {
            if(pdfDoc && pageNum >= pdfDoc.numPages) return;
            pageNum++;
            renderPage(pageNum);
        }

        // --- Zen Mode ---
        const zenBtn = document.getElementById('zenModeBtn');
        const sidebar = document.getElementById('readerSidebar');
        const navbar = document.querySelector('nav');
        
        zenBtn.addEventListener('click', () => {
            document.body.classList.toggle('zen-active');
            
            if(document.body.classList.contains('zen-active')) {
                sidebar.style.display = 'none';
                navbar.style.display = 'none';
                zenBtn.style.position = 'fixed';
                zenBtn.style.top = '1rem';
                zenBtn.style.right = '1rem';
                zenBtn.style.zIndex = '100';
                zenBtn.classList.add('bg-black/50');
            } else {
                sidebar.style.display = 'flex';
                navbar.style.display = 'flex';
                zenBtn.style.position = '';
                zenBtn.classList.remove('bg-black/50');
            }
        });

        // Initialize
        if(chapterFile) loadContent();
        
        // Chapter Nav
        document.getElementById('prevChapterBtn').onclick = () => {
           // Logic to find prev chapter ID from 'chapters' array and redirect
           alert('Prev Chapter logic needs wiring');
        };
        document.getElementById('nextChapterBtn').onclick = () => {
           alert('Next Chapter logic needs wiring');
        };

    </script>
</body>
</html>
